<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- J4: bend the wrist. Distances in meters; angles in radians. -->
  <!-- wrist_link: a rigid assembly of parts. The mesh supplies its shape; visual is appearance, collision is contact geometry. -->
  <link name="wrist_link">
    <visual>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/wrist_link.stl" />
      </geometry>
      <material name="wrist_link_color">
        <color rgba="0.85 0.32 0.12 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/wrist_link.stl" />
      </geometry>
    </collision>
  </link>
  <!-- j4: connects forearm_link to wrist_link. Origin locates the joint in the parent frame. Axis gives the movement direction in the joint frame. Range: -90.0 to 90.0 degrees. -->
  <joint name="j4" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_link" />
    <origin xyz="0.144883953563 0.03 -0.0058" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="0" velocity="0.5235987755982988" />
  </joint>
</robot>
