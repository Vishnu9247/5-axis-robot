<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Fixed gripper frame and gripping reference point. Distances in meters; angles in radians. -->
  <!-- gripper_base: a rigid assembly of parts. The mesh supplies its shape; visual is appearance, collision is contact geometry. -->
  <link name="gripper_base">
    <visual>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/gripper_base.stl" />
      </geometry>
      <material name="gripper_base_color">
        <color rgba="0.85 0.32 0.12 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/gripper_base.stl" />
      </geometry>
    </collision>
  </link>
  <!-- grasp_tcp: reference frame only; it has no visible shape. -->
  <link name="grasp_tcp" />
  <!-- gripper_mount_fixed: connects tool_flange to gripper_base. Origin locates the joint in the parent frame. -->
  <joint name="gripper_mount_fixed" type="fixed">
    <parent link="tool_flange" />
    <child link="gripper_base" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <!-- grasp_tcp_fixed: connects gripper_base to grasp_tcp. Origin locates the joint in the parent frame. -->
  <joint name="grasp_tcp_fixed" type="fixed">
    <parent link="gripper_base" />
    <child link="grasp_tcp" />
    <origin xyz="0 0 0.096" rpy="0 0 0" />
  </joint>
</robot>
