<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Stationary base and bench reference. Distances in meters; angles in radians. -->
  <!-- world: reference frame only; it has no visible shape. -->
  <link name="world" />
  <!-- base_link: a rigid assembly of parts. The mesh supplies its shape; visual is appearance, collision is contact geometry. -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/base_link.stl" />
      </geometry>
      <material name="base_link_color">
        <color rgba="0.18 0.30 0.46 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/base_link.stl" />
      </geometry>
    </collision>
  </link>
  <!-- world_to_base: connects world to base_link. Origin locates the joint in the parent frame. -->
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
