Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 42; 42; 46
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 0.1
      Plane: XY
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: Joint Frames
      Enabled: false
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.4
      Pitch: 0.5
      Yaw: 0.8
      Focal Point:
        X: 0.15
        Y: 0
        Z: 0.3
Window Geometry:
  Width: 1280
  Height: 900
